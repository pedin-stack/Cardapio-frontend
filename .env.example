# Copie para .env.local. NEXT_PUBLIC_* são embutidas no bundle em BUILD: mudou, gere o build de novo.

# Origem da API (sem barra no fim). Só do servidor: o navegador chama /api/* no próprio front e o
# src/middleware.ts repassa para cá. No dev, o padrão é http://localhost:8080.
API_ORIGEM=http://localhost:8080
# Segredo que prova à API que a chamada veio do front (o MESMO FRONT_SEGREDO do .env da API).
# Só do servidor. Vazio no dev (a API de dev não exige).
API_SEGREDO_FRONT=

# Supabase (só Storage das fotos): URL do projeto e a chave ANON (pública). Nunca a service_role.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=
# Bucket (privado) das mídias, o mesmo SUPABASE_BUCKET do backend. O front só ENVIA (upload assinado);
# para exibir, a API devolve URLs assinadas.
NEXT_PUBLIC_SUPABASE_BUCKET=cardapio-midias
